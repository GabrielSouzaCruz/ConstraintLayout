<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tvHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/purple_700"
            android:text="@string/blog_header"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <ImageView
            android:id="@+id/imgPostHeader"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:scaleType="centerCrop"
            android:src="@drawable/imagem_blog_header"
            android:contentDescription="Imagem do post"
            app:layout_constraintTop_toBottomOf="@id/tvHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvPostTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/blog_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:paddingHorizontal="16dp"
            android:paddingTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/imgPostHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvAuthor"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/blog_author"
            android:textSize="13sp"
            android:textColor="@color/gray"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvPostTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvDate" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/blog_date"
            android:textSize="13sp"
            android:textColor="@color/gray"
            android:paddingEnd="16dp"
            android:paddingTop="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvPostTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBaseline_toBaselineOf="@id/tvAuthor" />

        <TextView
            android:id="@+id/tvPostBody"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/blog_body"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:lineSpacingMultiplier="1.4"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/tvAuthor"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnAnterior"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_anterior"
            app:backgroundTint="@color/purple_700"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            app:cornerRadius="5dp"
            app:layout_constraintTop_toBottomOf="@id/tvPostBody"
            app:layout_constraintEnd_toStartOf="@id/btnProximo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_bias="0.65" />

        <Button
            android:id="@+id/btnProximo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/btn_proximo"
            app:backgroundTint="@color/purple_700"
            android:textColor="@color/white"
            android:layout_marginTop="24dp"
            android:layout_marginStart="8dp"
            app:cornerRadius="5dp"
            app:layout_constraintTop_toBottomOf="@id/tvPostBody"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/btnAnterior" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>